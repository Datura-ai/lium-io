#!/bin/sh
# Stand-in for NVIDIA's prestart hook on a machine without GPUs: dockerd only checks that the binary exists when
# `--gpus` is used, then calls it before the container's init. Doing nothing = the container starts without GPUs.
# With E2E_GPU=1 dind is not started at all (docker-compose.gpu.yml), so this file is never used there.
exit 0
