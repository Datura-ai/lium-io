# executor runtime for the e2e stack (fake, public values; see stack.env)
ENV=prod
# no compute-app in the stack: an empty URL disables the on-boot cache-template pre-pull
COMPUTE_REST_API_URL=
# ports the validator may map for rentals; published on the dind address (= the executor's address)
RENTING_PORT_RANGE=40000-40019
# refuse an SSH key the validator did not bind to this executor's miner (or the pool): every suite then proves the
# validator and the miner send the binding, and tests/protocol proves a key bound to another miner is refused
REQUIRE_MINER_BOUND_SSH_KEY=true
