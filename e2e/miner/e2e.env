# miner runtime for the e2e stack (fake, public values; see stack.env)
ENV=prod
BITTENSOR_WALLET_DIRECTORY=/root/.bittensor/wallets
BITTENSOR_WALLET_NAME=e2e
BITTENSOR_WALLET_HOTKEY_NAME=miner
BITTENSOR_NETUID=37
BITTENSOR_NETWORK=test
# no chain in the stack: pin the endpoint to a dead local address so nothing in the miner can dial the PUBLIC test
# chain by default (the network name alone would resolve it); the tester pins the same way
BITTENSOR_CHAIN_ENDPOINT=ws://127.0.0.1:9
POSTGRES_DB=miner
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@miner-db:5432/miner
# no chain in the stack: never sync (registration, axon, validator list); the validator is trusted by hotkey
DEBUG_ENABLED=true
DEBUG_SKIP_SYNC_FLOW=true
DEBUG_SKIP_VALIDATOR_REGISTRATION_CHECK=false
COMPUTE_REST_API_URL=http://127.0.0.1:9/api
MINER_PORTAL_API_URL=http://127.0.0.1:9/api
