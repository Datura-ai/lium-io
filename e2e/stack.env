# Shared values for the lium-io e2e stack. Every secret here is fake and public: the three hotkeys are derived
# from BIP-39 test-vector mnemonics and exist only inside this compose network. Never reuse them anywhere else.
E2E_NET_SUBNET=172.30.0.0/24
E2E_EXECUTOR_IP=172.30.0.10
E2E_MINER_IP=172.30.0.20
E2E_REDIS_IP=172.30.0.30

# the validator (signs into the miner, verifies the executor, drives rentals)
E2E_VALIDATOR_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
E2E_VALIDATOR_HOTKEY=5EPCUjPxiHAcNooYipQFWr9NmmXJKpNG5RhcntXwbtUySrgH
# the miner (owns the executor; the executor accepts only requests it signed)
E2E_MINER_MNEMONIC=legal winner thank year wave sausage worth useful legal winner thank yellow
E2E_MINER_HOTKEY=5EHgWw2Af1pnoc7f1A8bfmM97W3DAYW8xr82RfhLL9oAabAe
# an unrelated key: signatures made with it must be refused everywhere
E2E_STRANGER_MNEMONIC=letter advice cage absurd amount doctor acoustic avoid letter advice cage above
E2E_STRANGER_HOTKEY=5EtaiguVmKZ9Vewv7HkS86hWTS8Lf4twTSADg29PH5rM5Wng

E2E_EXECUTOR_PORT=8001
E2E_EXECUTOR_SSH_PORT=22
E2E_MINER_PORT=8000
E2E_EXECUTOR_UUID=0b2a6d1e-9e2e-4e2e-8e2e-000000000e2e
# a second executor row the miner owns but nobody answers on: the cycle must drop it, not stall on it
E2E_DEAD_EXECUTOR_UUID=0b2a6d1e-9e2e-4e2e-8e2e-00000000dead
E2E_DEAD_EXECUTOR_IP=172.30.0.99

# rental image the validator starts on the executor: small, has sshd, no GPU libraries (tests/rental builds it)
E2E_POD_IMAGE=lium-e2e/pod:latest

# E2E_GPU is deliberately NOT set here: `include stack.env` makes every line a make variable, and a make variable
# overrides the caller's environment, so `E2E_GPU=1 make …` would silently take the CPU branch. Set it in the
# environment (`E2E_GPU=1 make e2e-full`); the Makefile defaults it to empty.
