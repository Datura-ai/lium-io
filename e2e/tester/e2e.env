# the validator's settings for the tester (fake, public values; see stack.env)
ENV=prod
DEPLOY_ENV=LOCAL
BITTENSOR_WALLET_DIRECTORY=/root/.bittensor/wallets
BITTENSOR_WALLET_NAME=e2e
BITTENSOR_WALLET_HOTKEY_NAME=validator
BITTENSOR_NETUID=37
BITTENSOR_NETWORK=test
# no chain in the stack: tests/conftest.py keeps SubtensorClient disconnected (a registration check against a
# real network would exit()); the endpoint below is never dialled
BITTENSOR_CHAIN_ENDPOINT=ws://127.0.0.1:9
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@val-db:5432/validator
ASYNC_SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@val-db:5432/validator
REDIS_HOST=redis
REDIS_PORT=6379
# the validator talks to the miner over REST (the path lium-mine providers take through the central miner)
USE_REST_API=true
# no compute-app in the stack: every client falls back (shared config → packaged defaults, rented set → empty)
COMPUTE_APP_URI=ws://127.0.0.1:9/api
COMPUTE_REST_API_URL=http://127.0.0.1:9/api
COMPUTE_REST_API_URL_EXTERNAL=http://127.0.0.1:9/api
MINER_PORTAL_REST_API_URL=http://127.0.0.1:9/
# a Lium pod or a plain CI box has no sysbox; the flag-on verdict is asserted separately (tests/cycle)
REQUIRE_SYSBOX_FOR_UNRENTED=false
DEBUG_SKIP_STORAGE_CHECK=true
PYTHONPATH=/app/src
# encrypted rental volumes need a master secret (fake, public); the rental suite exercises the encrypted path as prod does
VOLUME_MASTER_SECRET=e2e-volume-master-secret-0123456789abcdef-not-a-real-secret
