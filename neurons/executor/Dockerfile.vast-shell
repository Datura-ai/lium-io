# Experiment-only sidecar shell for the vast_api module (see src/vast_api/README.md).
# Versions kept loose on purpose: this image never ships to prod.
FROM python:3.11-slim

# nsenter (util-linux) for host-namespace ops; docker CLI not needed (docker-py over socket)
RUN apt-get update && apt-get install -y --no-install-recommends util-linux \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "fastapi>=0.100" "uvicorn>=0.23" "docker>=6" \
    "requests>=2.31" "pydantic>=2" "pydantic-settings>=2" "vastai>=0.1"

COPY src/vast_api /app/vast_api
WORKDIR /app

CMD ["python", "-m", "vast_api.shell"]
