[Unit]
Description=Resume Lium CVM host provisioning after reboot
After=network-online.target
Wants=network-online.target
# The unit cannot fire unless it was explicitly armed. arm_resume.yml writes
# this file LAST, after the scripts and the unit are in place.
ConditionPathExists={{ lium_state_dir }}/resume.state

[Service]
Type=oneshot

# systemd applies NO start timeout to Type=oneshot by default. This unit is the
# whole unattended half of the converge: if anything inside it blocks — a wedged
# filesystem, a hung package download, a network mount that never answers —
# nothing reaps it, and the host sits at boot indefinitely, provisioning
# unfinished and silent about why. A timeout turns that into a failed unit with
# a reason in resume.log, which ExecStopPost then cleans up after.
TimeoutStartSec={{ lium_resume_timeout_sec }}

# The resume guard uses this to decide the host is looping. Without it the guard
# falls back to its own built-in default and an operator's
# lium_max_converge_reboots override never reaches the one code path that acts
# on it — the unit runs with a different cap from the rest of the playbook.
Environment=LIUM_MAX_CONVERGE_REBOOTS={{ lium_max_converge_reboots }}
Environment=LIUM_STATE_DIR={{ lium_state_dir }}

ExecStartPre={{ lium_helper_dir }}/lium-resume-guard.sh
ExecStart={{ lium_helper_dir }}/lium-resume.sh

# ExecStopPost, NOT ExecStartPost. This runs on EVERY exit path — success,
# failure, signal. With ExecStartPost, a run that fails its last task never
# reaches it, the enablement symlink survives, and six weeks later an unrelated
# unattended-upgrades kernel reboot fires the whole playbook again at 04:00
# while a customer holds an open rental.
#
# It also runs after an ExecStartPre REFUSAL, so a stray
# `systemctl start lium-cvm-resume` between arming and the reboot disables the
# unit and the real resume never happens. The window is small and the outcome is
# visible — `systemctl is-enabled` reports disabled, and the converge simply has
# to be re-run by hand — which is why arming writes resume.state LAST and why
# the VM runbook checks is-enabled after the reboot.
ExecStopPost=-/usr/bin/systemctl disable lium-cvm-resume.service

StandardOutput=append:{{ lium_log_dir }}/resume.log
StandardError=append:{{ lium_log_dir }}/resume.log

[Install]
WantedBy=multi-user.target
