{% set _ = checks.append({
  'id': 'sgx.qgsd_vsock_4050',
  'title': 'qgsd serves TD quotes over vsock',
  'status': 'UNKNOWN' if not (lium.qgsd_vsock_4050.readable | bool) else ('OK' if (lium.qgsd_vsock_4050.value | bool) else 'MUST_FIX'),
  'observed': (lium.qgsd_vsock_4050.reason if not (lium.qgsd_vsock_4050.readable | bool) else ('listening on vsock 4050' if (lium.qgsd_vsock_4050.value | bool) else 'no vsock listener on 4050')),
  'expected': 'a v_str LISTEN on port 4050',
  'remediation': 'Uncomment `port = 4050` in /etc/qgs.conf and restart qgsd. It ships commented out, so qgsd serves a unix socket instead, reports active, and never answers the guest — the CVM then reboots at around 160 seconds with "vsock failure: Connection reset by peer (os error 104)".',
