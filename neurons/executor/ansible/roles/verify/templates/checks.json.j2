{#-
  Every check, built as data and emitted as JSON so nothing has to be escaped by
  hand. Each id has a matching `### <id>` heading in roles/verify/README.md, and
  tests/test_verify_schema.sh asserts the schema enum, this list and those
  headings all agree.

  Status vocabulary:
    OK       the check passed
    WARN     worth reading, does not block
    MUST_FIX blocks; bootstrap.sh exits non-zero
    UNKNOWN  could not be read at all — never silently a pass
    SKIPPED  deliberately not run, with a reason
-#}
{% set checks = [] %}

{#- ---- the six preflight-derived checks, recomputed from lium.* ---- #}
{% set _ = checks.append({
  'id': 'os.supported',
  'title': 'Ubuntu release is supported',
  'status': 'OK' if lium.os_version_id in lium_os_matrix else 'MUST_FIX',
  'observed': 'Ubuntu ' ~ (lium.os_version_id | default('unknown')),
  'expected': 'one of ' ~ (lium_os_matrix.keys() | list | join(', ')),
  'remediation': 'Reinstall on Ubuntu 25.10 or 26.04 LTS. Older releases lack the TDX kernel support this stack needs.',
  'evidence_source': '/etc/os-release',
  'severity': 'blocker'}) %}

{% set _ = checks.append({
  'id': 'cpu.tdx_enabled',
  'title': 'Intel TDX is enabled',
  'status': 'OK' if (lium.tdx_param.value | default('N')) == 'Y' else ('UNKNOWN' if not (lium.tdx_param.readable | bool) else 'MUST_FIX'),
  'observed': 'kvm_intel tdx parameter = ' ~ (lium.tdx_param.value | default('unreadable')),
  'expected': 'Y',
  'remediation': 'BIOS: enable Intel TDX (and TME / TME-MT) in the CPU security menu. The kernel must be Canonical intel or mainline 6.16 or newer.',
  'evidence_source': '/sys/module/kvm_intel/parameters/tdx',
  'severity': 'blocker'}) %}

{% set _ = checks.append({
  'id': 'iommu.vt_d',
  'title': 'VT-d / IOMMU is enabled',
  'status': 'OK' if (lium.iommu_present.value | default(false) | bool) else 'MUST_FIX',
  'observed': 'IOMMU groups present' if (lium.iommu_present.value | default(false) | bool) else '/sys/class/iommu is empty',
  'expected': 'at least one IOMMU group',
  'remediation': 'BIOS: enable VT-d / Intel Virtualization Technology for Directed I/O. Without it no device can be passed through to a TD guest.',
  'evidence_source': '/sys/class/iommu/',
  'severity': 'blocker'}) %}

{% set _ = checks.append({
  'id': 'sgx.devices_present',
