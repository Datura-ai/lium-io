{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lium.io/schemas/cvm-host/verify-report-1.0.0.json",
  "title": "Lium CVM host verify report",
  "description": "The machine-readable output contract of the CVM host provisioning playbook. Humans, bootstrap.sh's exit code, and cvmd's startup checks all read this same document. Check ids are stable: every id in the enum below has a documented meaning under a matching '### <id>' heading in roles/verify/README.md, and tests/test_verify_schema.sh asserts the two sets are exactly equal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "host", "summary", "checks"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Bumped on any breaking change to this contract."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the run that produced this report."
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os", "kernel", "boot_id"],
      "properties": {
        "hostname": {"type": "string"},
        "os": {"type": "string"},
        "kernel": {"type": "string"},
        "boot_id": {"type": "string"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "warn", "must_fix", "unknown", "skipped"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "must_fix": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "observed", "expected", "remediation", "evidence_source", "severity"],
        "properties": {
          "id": {
            "description": "Stable identifier. Consumers match on this, never on the title or the human summary.",
            "enum": [
              "os.supported",
              "cpu.tdx_enabled",
              "iommu.vt_d",
              "sgx.devices_present",
              "boot.grub_present",
              "gpu.cc_capable_present",
              "sgx.registration_pck_certs",
              "sgx.pccs_active",
              "sgx.qgsd_vsock_4050",
              "sgx.qpl_secure_cert_false",
              "sgx.keyprovider_production",
              "net.intel_api_reachable",
              "gpu.cc_mode_all_on",
              "gpu.vfio_bound_all",
              "gpu.device_inventory",
              "kernel.dma_entry_limit",
              "kernel.dma_persisted",
              "kernel.cmdline_tokens",
              "kernel.grub_persisted",
              "kernel.grub_conflicting_tokens",
              "qemu.version_9_2_1",
              "qemu.client_conf_path",
              "qemu.binary_sha256",
              "docker.installed",
              "repo.present",
              "repo.app_pristine",
              "repo.ref_behind",
              "repo.os_image_present",
              "repo.runner_digest_set",
              "net.local_listeners",
              "net.acl_probe_required",
              "guard.host_state",
              "cvmd.stub_status",
              "catalog.stub_status"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "status": {
            "description": "UNKNOWN means the check could not be read at all. It is never silently collapsed into a pass or a failure.",
            "enum": ["OK", "WARN", "MUST_FIX", "UNKNOWN", "SKIPPED"]
          },
          "observed": {"type": "string"},
          "expected": {"type": "string"},
          "remediation": {
            "type": "string",
            "minLength": 1,
            "description": "What to do about it. Never empty: providers run this unattended with no Lium access to their host, so this text is the support channel."
          },
          "evidence_source": {"type": "string", "minLength": 1},
          "severity": {
            "enum": ["blocker", "degraded", "info"]
          }
        }
      }
    }
  }
}
