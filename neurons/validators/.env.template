BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY_NAME=default

POSTGRES_DB=compute-subnet-db
POSTGRES_PORT=6432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@localhost:6432/compute-subnet-db
ASYNC_SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:password@localhost:6432/compute-subnet-db

BITTENSOR_NETUID=51
BITTENSOR_NETWORK=finney

# Optional field. your RPC_RUL of subtensor. example: http://ip:9944
# SUBTENSOR_EVM_RPC_URL=

INTERNAL_PORT=8010
EXTERNAL_PORT=8010

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# GPU hardware-signature challenge (DAH-3137, liumd building block). Off by default; absence of the prober binary in
# the executor image skips the check. The HMAC key must match the LIUM_SIG_KEY baked into the executor image.
ENABLE_GPU_SIGNATURE_CHECK=false
GPU_SIGNATURE_ENFORCEMENT_ENABLED=false
GPU_SIGNATURE_HMAC_KEY=
GPU_SIGNATURE_BINARY_RELATIVE=bin/gpu_sig
GPU_SIGNATURE_MAX_CONCURRENT=8
GPU_SIGNATURE_TIMEOUT_SECONDS=120

COMPUTE_APP_URI=wss://lium.io/api

HOST_WALLET_DIR=/home/ubuntu/.bittensor/wallets

