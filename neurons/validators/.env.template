BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY_NAME=default

POSTGRES_DB=compute-subnet-db
POSTGRES_PORT=6432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@localhost:6432/compute-subnet-db
ASYNC_SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:password@localhost:6432/compute-subnet-db

BITTENSOR_NETUID=51
BITTENSOR_NETWORK=finney

# Optional field. Websocket URL of your own subtensor node. When set, the validator dials it
# instead of the public BITTENSOR_NETWORK node; the "Subtensor connected" startup log names the endpoint used.
# BITTENSOR_CHAIN_ENDPOINT=ws://ip:9944
# Optional. Ordered, comma-separated list instead of the single endpoint above: your own nodes first;
# the public BITTENSOR_NETWORK node is always tried last. On a connect or read failure the client moves to
# the next one (log line "Subtensor endpoint switched from=... to=...") and does not dial the failed one again
# for BITTENSOR_CHAIN_ENDPOINT_RETRY_AFTER_SECONDS (default 300); after that it returns to the first on the next sync.
# BITTENSOR_CHAIN_ENDPOINTS=ws://ip:9944,ws://ip2:9944
# BITTENSOR_CHAIN_ENDPOINT_RETRY_AFTER_SECONDS=300

# Optional field. your RPC_RUL of subtensor. example: http://ip:9944
# SUBTENSOR_EVM_RPC_URL=

INTERNAL_PORT=8010
EXTERNAL_PORT=8010

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# DAH-3006: false = Redis commands run concurrently on the bounded pool instead of queueing
# behind one process-wide lock (p50 73 s per executor in a 500-executor wave). true = legacy.
REDIS_COMMAND_LOCK_ENABLED=true

COMPUTE_APP_URI=wss://lium.io/api
# GPU fault probe (DAH-3035): indexed access, atomics and pointer-chase kernels after the matmul. CHECK runs it and logs
# the verdict; ENFORCEMENT lets a fault zero the score. Both off by default (shadow mode first).
GPU_FAULT_PROBE_CHECK_ENABLED=false
GPU_FAULT_PROBE_ENFORCEMENT_ENABLED=false
# GPU anchor (DAH-3457): a listed node keeps one fixed set of GPU UUIDs. false = a changed set (a missing card included) is
# GPU_UUID_CHANGED and the event records what the hard rule would have decided. true = a missing card is GPU_MISSING (score 0
# until it is back), any card outside the set breaks the anchor: score 0 on every later cycle for this node id until it is
# re-registered. false again = the broken mark stays in the record but is ignored.
GPU_ANCHOR_HARD_ENABLED=false
# Executor image check (DAH-2701): compares the executor container's image digest with EXECUTOR_IMAGE_REF's. false = an
# outdated image is logged as a warning with both digests; score and incentive are unchanged. true = an idle outdated
# executor fails validation and every outdated executor earns 0. Set to true only after nodes auto-update again (DAH-3419).
EXECUTOR_IMAGE_CHECK_ENFORCE=false
# Rental probe (DAH-3436): on an idle node, rent it from the validator once per interval through the normal pod path
# (default renter image, probe-owned SSH key, verified ports), wait for sshd on the mapped port, log in, run `nvidia-smi -L`,
# tear down. A failed step zeroes the score and clears the verified job until a probe passes (RENTAL_PROBE_FAILED). Off by default.
RENTAL_PROBE_ENABLED=false
RENTAL_PROBE_INTERVAL_HOURS=6
RENTAL_PROBE_SSH_DEADLINE_SECONDS=90
# DinD probe first-miss grace (DAH-3597): a DinD probe that never reached its container (docker run refused, sshd not up in
# 30 s, SSH reset) measured nothing about sysbox. true = the first such miss inside the TTL keeps the last known sysbox value
# and the next cycle re-measures; a second miss inside the TTL records the downgrade (SYSBOX_REQUIRED_MISSING, score 0) as
# before; a probe that reaches its container clears the window. false = every miss is recorded at once. Off by default.
DIND_PROBE_FIRST_MISS_GRACE=false
DIND_PROBE_FIRST_MISS_GRACE_TTL_SECONDS=3600

HOST_WALLET_DIR=/home/ubuntu/.bittensor/wallets
# Cold-sample retry (DAH-2959): re-measure a never-validated node's cold VerifyX download sample once before failing it.
# Gate, threshold and known-host EMA are unchanged. Off by default.
VERIFYX_COLD_SAMPLE_RETRY_ENABLED=false

# Rental volume fast path (DAH-3240): on a rent, read DockerRootDir / free disk / vloopback volumes / loopback plugin state
# in one ssh command and skip `docker plugin install` (a Docker Hub round trip) when the plugin is already enabled. Off by default.
RENTAL_VOLUME_FAST_PATH_ENABLED=false
# Rental pre-run host probe (DAH-3257): on a rent, read the host listings the steps before `docker run` need (containers,
# volumes, mounted volumes, GPU minor map, device nodes, nvidia-smi power state, the image's encryption label) in one ssh
# command instead of ~8. Removals and writes run as before; a failed probe leaves every step on its own commands. Off by default.
RENTAL_PRERUN_HOST_PROBE_ENABLED=false

# Rented-pod SSH probe: each cycle, TCP-connect to every RUNNING rented pod's mapped SSH port and read its
# authorized_keys; a pod seen healthy once that then fails RENTED_POD_SSH_PROBE_CYCLES cycles in a row (2 = about 30 min)
# raises RENTED_POD_SSH_UNREACHABLE and is reported to the backend once per outage. Score unchanged. On by default.
# The per-pod Redis marks expire STATE_TTL_SECONDS after the last probe of that pod (24 h) and are deleted when the
# rental closes. A Redis error skips the probe for that cycle (logged) and never changes the check's verdict.
RENTED_POD_SSH_PROBE_ENABLED=true
RENTED_POD_SSH_PROBE_CYCLES=2
RENTED_POD_SSH_PROBE_TIMEOUT_SECONDS=5
RENTED_POD_SSH_PROBE_STATE_TTL_SECONDS=86400
# Reports go out at the end of the cycle, only when the fleet says the pods are at fault: above this share of the
# cycle's probed pods failing the mapped-port check (on 5 or more pods), or a cycle the executor-SSH check already
# called a validator-side outage, holds every report back (logged as RENTED_POD_SSH_PROBE_SUPPRESSED_FLEET).
RENTED_POD_SSH_PROBE_FLEET_FAIL_MAX=0.5

# First-pass fast path (DAH-3011): a never-validated executor gets a right-sized matmul (min(card VRAM, this MB)) and a
# smaller VerifyX write (GB of RAM / disk) on its first pass; scored verifications are unchanged. Off by default.
FIRST_PASS_FAST_PATH_ENABLED=false
FIRST_PASS_MATMUL_VRAM_MB=8192
FIRST_PASS_VERIFYX_MEMORY_MAX_TEST_GB=16
FIRST_PASS_VERIFYX_STORAGE_TEST_GB=1

# liumd phase 1 (DAH-2834): one signed POST /verify to executors that advertise local_verify/1 replaces the SSH-driven
# matmul and VerifyX commands. The POST rides the validator's SSH session to the executor's loopback port (the executor
# refuses any other peer); every refusal/timeout/mismatch falls back to SSH for that step. Off by default.
VALIDATOR_LOCAL_VERIFY_ENABLED=false
LOCAL_VERIFY_TIMEOUT_SECONDS=240
LOCAL_VERIFY_CONNECT_TIMEOUT_SECONDS=5

# Express lane (DAH-2958): verify and publish never-validated executors ahead of the 15-min cycle. Off by default.
# The in-flight caps bound the extra load a registration flood can add (per tick, and per miner).
EXPRESS_LANE_ENABLED=false
EXPRESS_LANE_TICK_SECONDS=30
EXPRESS_LANE_MAX_IN_FLIGHT=4
EXPRESS_LANE_MAX_IN_FLIGHT_PER_MINER=2

# Designated-hotkey fast validation: the FIRST, unscored verification (the express lane's) of a node registered under
# one of the designated miner hotkeys below skips the collateral read and VerifyX and runs the matmul at the first-pass
# VRAM budget; every check that catches a broken node (scrape, GPU count/model/VRAM, disk, NVML digest, ports, sysbox, GPU
# compute probe, rental verification) runs as on any node, and every scored cycle is unchanged. Off by default; an empty
# hotkey list selects nobody. The hotkeys are operator-set (comma-separated ss58) — nothing a provider sets is read.
# OPERATOR RULE: DESIGNATED_MINER_HOTKEYS holds DEDICATED hotkeys only — never a pool hotkey that custodied
# (wallet-free) provider accounts list their nodes under (the portal's LIUM_POOL_HOTKEYS): the profile would then apply
# to every such provider's first pass. Mirror the portal's pool hotkeys into LIUM_POOL_HOTKEYS below and the validator
# refuses to start on any overlap; with the mirror empty it logs a startup warning instead.
DESIGNATED_HOTKEY_FAST_VALIDATION_ENABLED=false
DESIGNATED_MINER_HOTKEYS=
LIUM_POOL_HOTKEYS=

# Executor image rollout grace (DAH-3405): for this many validation cycles, counting the one in which the registry digest
# of EXECUTOR_IMAGE_REF was seen to change, an executor that fails the way a watchtower restart makes it fail (SSH
# unreachable, scrape failed, ports missing, image not yet the new one) gets no verdict instead of a 0 - nothing is scored
# or published for it. Default 2 = the cycle the push landed in and the next. Capped at 2: a withheld executor publishes
# nothing, and the backend marks an executor whose row is not updated for 1 h inactive (EXECUTOR_INACTIVE_MID_RENTAL).
# 0 turns the window off.
EXECUTOR_ROLLOUT_GRACE_CYCLES=2

# Rented node missing from the miner's answer (DAH-3558): on, the cycle's whole-miner wave writes one failed result
# (score 0, availability error RENTED_EXECUTOR_NOT_LISTED) for every rented executor of a miner that the backend lists
# and the miner did not return, so the backend's staleness sweep sees a row instead of silence (it weighs the row as it
# weighed the silence: the penalty verdict does not change). Manual rentals keep their forced pass. Off by default; turn
# on only once lium-platform#509 (the portal label and the sweep's reading of the code) is deployed.
RENTED_EXECUTOR_NOT_LISTED_REPORT_ENABLED=false

