FROM daturaai/ubuntu:24.04-py3.11

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy preflight check module and services (for constants)
COPY src/preflight /app/preflight
COPY src/services /app/services

# Copy libraries
COPY libdmcompverify.so /usr/lib/libdmcompverify.so
COPY libverifyx.so /usr/lib/libverifyx.so
COPY libinspector.so /usr/lib/libinspector.so

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    nvidia-ml-py

# Set Python path
ENV PYTHONPATH=/app

# Entry point (allows passing --debug flag)
ENTRYPOINT ["python3", "/app/preflight/main.py"]
CMD []
