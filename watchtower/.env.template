# Watchtower Configuration
# Automatically monitors and updates Docker images with validator-signed digests

# Enable/disable watchtower service
WATCHTOWER_ENABLED=true

# Docker image to monitor (full image name including registry)
WATCHTOWER_IMAGE=daturaai/compute-subnet-executor-runner

# Check interval in seconds (default: 300 = 5 minutes)
WATCHTOWER_INTERVAL=300

# Validator endpoint URL that provides signed image digests
# This endpoint should return JSON with: {"digest": "sha256:...", "timestamp": 123456, "signature": "0x..."}
WATCHTOWER_ENDPOINT_URL=https://validator.example.com/api/watchtower/digest

# Validator's hotkey SS58 address for signature verification
# This public key is used to verify that digest responses are authentic
WATCHTOWER_VALIDATOR_HOTKEY=5F7X5UpKSr26KU3jKfpLmT8kuKtBNyHhEnfS8xtxPCqCb13p
